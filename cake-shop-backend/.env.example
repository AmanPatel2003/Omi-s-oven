# App
APP_NAME=CakeShopBackend
APP_ENV=development
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this
ALLOWED_ORIGINS=http://localhost:3000

# Database
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/cakeshop
MONGO_DB_NAME=cakeshop

# Redis (Celery broker + cache)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-jwt-secret-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Razorpay (UPI Payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary (Image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Maps
GOOGLE_MAPS_API_KEY=your-maps-api-key

# Twilio (WhatsApp notifications)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email (SendGrid)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourcakeshop.com

# SMS (MSG91)
MSG91_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
MSG91_SENDER_ID=CAKSHP

# Delivery zone radius (km)
DELIVERY_RADIUS_KM=10
